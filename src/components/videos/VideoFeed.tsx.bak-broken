"use client";
import { useEffect, useRef, useState } from "react";
import { createPortal } from "react-dom";
import Link from "next/link";
import { FaArrowLeft, FaChevronUp, FaChevronDown, FaWhatsapp, FaTiktok, FaPlay } from "react-icons/fa";
import type { Video } from "@/lib/videos";

export default function VideoFeed({ videos, phone }: { videos: Video[]; phone?: string }) {
  const box = useRef<HTMLDivElement>(null);
  const [ready, setReady] = useState(false);
  const [active, setActive] = useState(0);
  const [armed, setArmed] = useState(false);
  const [live, setLive] = useState<number | null>(null);
  useEffect(() => {
    setReady(true);
    setArmed(!!(navigator as any).userActivation?.hasBeenActive);
    document.body.style.overflow = "hidden";
    return () => { document.body.style.overflow = ""; };
  }, []);
  useEffect(() => {
    if (!armed) return;
    const t = setTimeout(() => setLive(active), 350);
    return () => clearTimeout(t);
  }, [active, armed]);
  useEffect(() => {
    const root = box.current;
    if (!root) return;
    const io = new IntersectionObserver((es) => {
      es.forEach((e) => { if (e.isIntersecting) setActive(Number((e.target as HTMLElement).dataset.i)); });
    }, { root, threshold: 0.6 });
    root.querySelectorAll("[data-i]").forEach((el) => io.observe(el));
    return () => io.disconnect();
  }, [ready, videos.length]);
  const go = (d: number) => box.current?.scrollBy({ top: d * box.current.clientHeight, behavior: "smooth" });
  useEffect(() => {
    const k = (e: KeyboardEvent) => {
      if (e.key === "ArrowDown") { e.preventDefault(); go(1); }
      if (e.key === "ArrowUp") { e.preventDefault(); go(-1); }
    };
    window.addEventListener("keydown", k);
    return () => window.removeEventListener("keydown", k);
  }, []);
  if (!ready) return null;
  return createPortal(
    <div className="fixed inset-0 bg-black text-white" style={{ zIndex: 9000 }} onPointerDown={() => setArmed(true)}>
      <div ref={box} className="h-full snap-y snap-mandatory overflow-y-scroll overscroll-contain" style={{ scrollbarWidth: "none" }}>
        {videos.map((v, i) => {
          const photo = v.url.includes("/photo/");
          const text = encodeURIComponent("Hi! I saw your video" + (v.title ? ": " + v.title : "") + " and I'd like to order.");
          return (
            <section key={v.key} data-i={i} className="flex h-full snap-start snap-always items-center justify-center">
              <div className="relative h-full max-w-full bg-neutral-900" style={{ aspectRatio: "9 / 16" }}>
                {armed && live === i && active === i ? (
                  <iframe src={v.embedUrl} title={v.title || "Video " + (i + 1)} className="absolute inset-0 h-full w-full" allow="autoplay; encrypted-media; fullscreen; picture-in-picture" allowFullScreen />
                ) : (
                  <button type="button" aria-label="Play" onClick={() => { setArmed(true); setLive(i); }} className="absolute inset-0 flex items-center justify-center">
                    {v.thumb && <img src={v.thumb} alt="" loading="lazy" className="absolute inset-0 h-full w-full object-cover opacity-80" />}
                    <span className="relative flex h-16 w-16 items-center justify-center rounded-full bg-white/90 text-neutral-900"><FaPlay className="ml-1" size={22} /></span>
                  </button>
                )}
                {active === i && (
                  <div className="absolute right-3 top-1/3 z-10 flex flex-col items-center gap-3 sm:left-full sm:right-auto sm:ml-4">
                    {phone && (
                      <a href={"https://wa.me/" + phone + "?text=" + text} target="_blank" rel="noopener noreferrer" aria-label="Order on WhatsApp" className="flex h-12 w-12 items-center justify-center rounded-full bg-green-600 text-2xl shadow-lg"><FaWhatsapp /></a>
                    )}
                    <a href={v.url} target="_blank" rel="noopener noreferrer" aria-label="Open on TikTok" className="flex h-12 w-12 items-center justify-center rounded-full bg-black/70 ring-1 ring-white/40"><FaTiktok /></a>
                    {photo && <span className="text-center text-[10px] font-semibold leading-tight">music<br />on TikTok</span>}
                    <button type="button" aria-label="Previous video" onClick={() => go(-1)} className="flex h-10 w-10 items-center justify-center rounded-full bg-black/60"><FaChevronUp /></button>
                    <button type="button" aria-label="Next video" onClick={() => go(1)} className="flex h-10 w-10 items-center justify-center rounded-full bg-black/60"><FaChevronDown /></button>
                  </div>
                )}
              </div>
            </section>
          );
        })}
      </div>
      <div className="pointer-events-none absolute inset-x-0 top-0 z-20 flex items-center justify-between p-3" style={{ paddingTop: "max(12px, env(safe-area-inset-top))" }}>
        <Link href="/" aria-label="Back to site" className="pointer-events-auto flex h-10 w-10 items-center justify-center rounded-full bg-black/60"><FaArrowLeft /></Link>
        <span className="rounded-full bg-black/60 px-3 py-1 text-xs font-semibold">{active + 1} / {videos.length}</span>
        <span className="w-10" />
      </div>
    </div>,
    document.body
  );
}
